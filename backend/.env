# ─── Variáveis de ambiente — Nativos Studio Pro (Backend FastAPI) ───────────────
# IMPORTANTE: Preencha todos os valores abaixo. Nunca commite chaves reais no git.

# Supabase — Configuração do projeto
SUPABASE_URL=https://blqvsglspdayrznnbzzf.supabase.co
SUPABASE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE

# Autenticação JWT (backend FastAPI local)
SESSION_SECRET=YOUR_RANDOM_LONG_SECRET_STRING_HERE

# Kiwify webhook — validação do token enviado pela Kiwify
# Configure o mesmo token no painel da Kiwify: Webhook URL + ?token=SEU_TOKEN
KIWIFY_WEBHOOK_TOKEN=YOUR_KIWIFY_WEBHOOK_TOKEN_HERE

# MongoDB (se usado)
MONGO_URL=mongodb://localhost:27017
DB_NAME=nativos_studio
CORS_ORIGINS=*