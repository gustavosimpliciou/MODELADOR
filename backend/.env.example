# ─── Variáveis de ambiente — Nativos Studio Pro (Backend FastAPI) ───────────────
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o arquivo .env com chaves reais no git.

# Supabase — Configuração do projeto (obrigatório)
SUPABASE_URL=https://blqvsglspdayrznnbzzf.supabase.co
SUPABASE_KEY=sua_service_role_key_aqui

# Autenticação JWT (backend FastAPI local)
SESSION_SECRET=gere_uma_string_aleatoria_longa_e_segura_aqui

# Kiwify webhook — validação do token enviado pela Kiwify (obrigatório)
# Configure o MESMO token no painel da Kiwify:
# Webhook URL: https://SEU_DOMINIO/api/webhook/kiwify?token=SEU_TOKEN
KIWIFY_WEBHOOK_TOKEN=seu_token_kiwify_aqui